{
  "id": null,
  "uid": "aice-backend-dependency-latency",
  "title": "Aice Backend Dependency Latency",
  "tags": ["aice", "backend", "dependency", "latency"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "Dependency Request Rate / min by Dependency + Operation",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency, operation, result) (rate(backend_dependency_requests_total{job=\"aice-backend\"}[5m])) * 60",
          "legendFormat": "{{dependency}} {{operation}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dependency Error Rate / min by Error Kind",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency, operation, error_kind) (rate(backend_dependency_requests_total{job=\"aice-backend\",result=\"error\"}[5m])) * 60",
          "legendFormat": "{{dependency}} {{operation}} {{error_kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dependency Duration avg (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency, operation) (rate(backend_dependency_request_duration_seconds_sum{job=\"aice-backend\"}[5m])) / sum by (dependency, operation) (rate(backend_dependency_request_duration_seconds_count{job=\"aice-backend\"}[5m])) * 1000",
          "legendFormat": "{{dependency}} {{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dependency Duration p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, dependency, operation) (rate(backend_dependency_request_duration_seconds_bucket{job=\"aice-backend\"}[5m]))) * 1000",
          "legendFormat": "{{dependency}} {{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Frontend Skill Finalize Path p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(backend_turn_duration_seconds_bucket{job=\"aice-backend\",path=\"frontend_skill_finalize\"}[5m]))) * 1000",
          "legendFormat": "frontend_skill_finalize"
        }
      ]
    }
  ]
}
