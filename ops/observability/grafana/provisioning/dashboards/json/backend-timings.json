{
  "id": null,
  "uid": "aice-backend-latency",
  "title": "Aice Backend Latency",
  "tags": ["aice", "backend", "latency"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Request Duration avg by Route (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(backend_http_request_duration_seconds_sum{job=\"aice-backend\"}[5m])) / sum by (route) (rate(backend_http_request_duration_seconds_count{job=\"aice-backend\"}[5m])) * 1000",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Duration p95 by Route (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(backend_http_request_duration_seconds_bucket{job=\"aice-backend\"}[5m]))) * 1000",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turn Duration avg by Path (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(backend_turn_duration_seconds_sum{job=\"aice-backend\"}[5m])) / sum by (path) (rate(backend_turn_duration_seconds_count{job=\"aice-backend\"}[5m])) * 1000",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turn Duration p95 by Path (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(backend_turn_duration_seconds_bucket{job=\"aice-backend\"}[5m]))) * 1000",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stage Duration avg by Stage (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(backend_turn_stage_duration_seconds_sum{job=\"aice-backend\"}[5m])) / sum by (stage) (rate(backend_turn_stage_duration_seconds_count{job=\"aice-backend\"}[5m])) * 1000",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stage Duration p95 by Stage (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(backend_turn_stage_duration_seconds_bucket{job=\"aice-backend\"}[5m]))) * 1000",
          "legendFormat": "{{stage}}"
        }
      ]
    }
  ]
}
