{
  "id": null,
  "uid": "aice-backend-timings",
  "title": "Aice Backend Timings",
  "tags": ["aice", "backend", "timings"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Backend Target Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "max(up{job=\"aice-backend\"})" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turn Throughput / min (by path,result)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path, result) (rate(backend_turn_total{job=\"aice-backend\"}[5m])) * 60",
          "legendFormat": "{{path}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend Turn Duration avg (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(backend_turn_duration_seconds_sum{job=\"aice-backend\"}[5m])) / sum(rate(backend_turn_duration_seconds_count{job=\"aice-backend\"}[5m])) * 1000",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend Turn Duration avg by Path (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(backend_turn_duration_seconds_sum{job=\"aice-backend\"}[5m])) / sum by (path) (rate(backend_turn_duration_seconds_count{job=\"aice-backend\"}[5m])) * 1000",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend Turn Duration p95 (ms) (if available)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "backend_turn_duration_seconds{job=\"aice-backend\",quantile=\"0.95\"} * 1000",
          "legendFormat": "p95 {{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend Error Throughput / min (by path)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(backend_turn_total{job=\"aice-backend\", result=\"error\"}[5m])) * 60",
          "legendFormat": "{{path}} errors/min"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend Stage Duration avg by Stage (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(backend_turn_stage_duration_seconds_sum{job=\"aice-backend\"}[5m])) / sum by (stage) (rate(backend_turn_stage_duration_seconds_count{job=\"aice-backend\"}[5m])) * 1000",
          "legendFormat": "{{stage}}"
        }
      ]
    }
  ]
}
