{
  "id": null,
  "uid": "aice-backend-skills",
  "title": "Aice Backend Skills",
  "tags": ["aice", "backend", "skills"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "Skill Invocations / min by Skill",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (skill) (rate(backend_skill_execute_total{job=\"aice-backend\"}[5m])) * 60",
          "legendFormat": "{{skill}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed Skills / min by Skill",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (skill) (rate(backend_skill_execute_total{job=\"aice-backend\",result=\"error\"}[5m])) * 60",
          "legendFormat": "{{skill}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed Skills / min by Skill + Error Kind",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (skill, error_kind) (rate(backend_skill_execute_total{job=\"aice-backend\",result=\"error\"}[5m])) * 60",
          "legendFormat": "{{skill}} {{error_kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Skill Duration avg by Skill (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (skill) (rate(backend_skill_execute_duration_seconds_sum{job=\"aice-backend\"}[5m])) / sum by (skill) (rate(backend_skill_execute_duration_seconds_count{job=\"aice-backend\"}[5m])) * 1000",
          "legendFormat": "{{skill}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Skill Duration p95 by Skill (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, skill) (rate(backend_skill_execute_duration_seconds_bucket{job=\"aice-backend\"}[5m]))) * 1000",
          "legendFormat": "{{skill}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dependency Errors / min by Dependency + Operation",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency, operation, error_kind) (rate(backend_dependency_requests_total{job=\"aice-backend\",result=\"error\"}[5m])) * 60",
          "legendFormat": "{{dependency}} {{operation}} {{error_kind}}"
        }
      ]
    }
  ]
}
