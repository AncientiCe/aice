{
  "id": null,
  "uid": "aice-frontend-timings",
  "title": "Aice Frontend Timings",
  "tags": ["aice", "frontend", "timings"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Frontend Target Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "max(up{job=\"aice-macos\"})" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Speech Start -> First TTS Sound avg (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(voice_turn_time_to_first_audio_seconds_sum{job=\"aice-macos\"}[5m])) / sum(rate(voice_turn_time_to_first_audio_seconds_count{job=\"aice-macos\"}[5m])) * 1000",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mic->STT / Endpointing / TTS First Audio avg (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(voice_mic_to_stt_duration_seconds_sum{job=\"aice-macos\"}[5m])) / sum(rate(voice_mic_to_stt_duration_seconds_count{job=\"aice-macos\"}[5m])) * 1000",
          "legendFormat": "mic_to_stt_avg"
        },
        {
          "refId": "B",
          "expr": "sum(rate(voice_endpointing_wait_duration_seconds_sum{job=\"aice-macos\"}[5m])) / sum(rate(voice_endpointing_wait_duration_seconds_count{job=\"aice-macos\"}[5m])) * 1000",
          "legendFormat": "endpointing_wait_avg"
        },
        {
          "refId": "C",
          "expr": "sum(rate(voice_tts_first_audio_latency_seconds_sum{job=\"aice-macos\"}[5m])) / sum(rate(voice_tts_first_audio_latency_seconds_count{job=\"aice-macos\"}[5m])) * 1000",
          "legendFormat": "tts_first_audio_avg"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stage avg (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(voice_stage_duration_seconds_sum{job=\"aice-macos\",stage=~\"stt|llm|tts\"}[5m])) / sum by (stage) (rate(voice_stage_duration_seconds_count{job=\"aice-macos\",stage=~\"stt|llm|tts\"}[5m])) * 1000",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Frontend RPC Duration avg by Endpoint (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(frontend_rpc_duration_seconds_sum{job=\"aice-macos\"}[5m])) / sum by (endpoint) (rate(frontend_rpc_duration_seconds_count{job=\"aice-macos\"}[5m])) * 1000",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Skill / TTS Playback avg (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (skill) (rate(frontend_skill_duration_seconds_sum{job=\"aice-macos\"}[5m])) / sum by (skill) (rate(frontend_skill_duration_seconds_count{job=\"aice-macos\"}[5m])) * 1000",
          "legendFormat": "skill {{skill}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(frontend_tts_playback_duration_seconds_sum{job=\"aice-macos\"}[5m])) / sum(rate(frontend_tts_playback_duration_seconds_count{job=\"aice-macos\"}[5m])) * 1000",
          "legendFormat": "tts_playback_avg"
        }
      ]
    }
  ]
}
