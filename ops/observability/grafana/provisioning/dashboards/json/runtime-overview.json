{
  "id": null,
  "uid": "aice-backend-service-overview",
  "title": "Aice Backend Service Overview",
  "tags": ["aice", "backend", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Backend Target Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "max(up{job=\"aice-backend\"})" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests / min",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(backend_http_requests_total{job=\"aice-backend\"}[5m])) * 60"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Errors / min",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(backend_http_requests_total{job=\"aice-backend\",result=\"error\"}[5m])) * 60"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests / min by Status Class",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(backend_http_requests_total{job=\"aice-backend\"}[5m])) * 60",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Errors / min by Route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(backend_http_requests_total{job=\"aice-backend\",result=\"error\"}[5m])) * 60",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "mDNS Advertisement Outcomes / min",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(backend_mdns_advertisement_total{job=\"aice-backend\"}[5m])) * 60",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
