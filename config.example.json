{
  "ollama_url": "http://127.0.0.1:11434",
  "model": "llama3.2",
  "llm": {
    "short_replies": true,
    "max_output_tokens": 48,
    "system_prompt": null,
    "skip_secondary_llm_for_skill_answers": false,
    "classifier_nonstream_enabled": false,
    "classifier_prompt_cache_enabled": false,
    "classifier_compact_fewshots_enabled": false,
    "classifier_retry_on_invalid_enabled": false,
    "classifier_max_output_tokens": 24,
    "classifier_structured_output_enabled": false,
    "classifier_num_ctx": 1024,
    "preload_model_on_startup": true,
    "model_keep_alive": "30m"
  },
  "pod_bind": "0.0.0.0:8765",
  "audio": {
    "input_device": null,
    "output_device": null,
    "chunk_timeout_ms": 80,
    "turn_window_ms": 1200,
    "idle_sleep_ms": 20,
    "speech_end_silence_ms": 180,
    "speech_rms_threshold": 0.008,
    "enable_endpointing_tuning": false,
    "tuned_chunk_timeout_ms": 40,
    "tuned_turn_window_ms": 900,
    "tuned_speech_end_silence_ms": 120
  },
  "stt": {
    "whisper_model_path": "models/whisper/ggml-tiny.en.bin",
    "preload_model_on_startup": true
  },
  "tts": {
    "piper_model_path": "models/piper/model.onnx",
    "piper_config_path": null,
    "enable_chunked_push_optimization": false,
    "push_chunk_bytes": 24
  },
  "service": {
    "health_bind": "127.0.0.1:8780",
    "metrics_enabled": true,
    "metrics_bind": "127.0.0.1:9001",
    "restart_backoff_secs": 3
  },
  "wake_word": {
    "enabled": true,
    "phrases": ["computer", "assistant", "word"],
    "sensitivity": 0.5,
    "cooldown_secs": 6
  },
  "search_provider": {
    "url": "",
    "api_key": null,
    "timeout_secs": 10
  },
  "assistant_profile": {
    "name": "Jarvis",
    "persona": "Private home assistant. Concise and helpful.",
    "unit_system": "metric",
    "time_format": "24h",
    "user_name": null
  },
  "smart_home": {
    "hue": {
      "enabled": false,
      "bridge_host": null,
      "app_key": null,
      "default_light_name": "Philips Hue White & Colour Ambience LED Table Light"
    }
  },
  "media": {
    "macos_music": {
      "enabled": false
    }
  },
  "memory": {
    "enabled": true,
    "path": "memory.json",
    "max_recent_turns": 10,
    "max_facts": 50,
    "autosave": true,
    "sqlite_path": "memory.sqlite"
  }
}
